{
  "name": "lumina-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Lumina — a Copilot-inspired, AI-powered assistant web app with real streaming AI, SQLite persistence, and full authentication.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "infisical run --env=dev -- concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "infisical run --env=prod -- cross-env NODE_ENV=production node server/index.js",
    "migrate": "infisical run --env=dev -- node server/scripts/migrate.js",
    "seed": "infisical run --env=dev -- node server/scripts/seed.js",
    "migrate:data": "infisical run --env=dev -- node server/scripts/migrate-data.js",
    "migrate:data:dry": "infisical run --env=dev -- node server/scripts/migrate-data.js --dry-run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^11.11.9",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dompurify": "^3.2.3",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  }
}
