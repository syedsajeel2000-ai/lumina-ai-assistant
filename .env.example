# ────────────────────────────────────────────────────────────────
# LUMINA — AI ASSISTANT · ENVIRONMENT CONFIGURATION (placeholders only)
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env file or API keys to GitHub.
#
# TWO FILES ARE LOADED, in this order:
#   1. `.env.vars`  — SECRETS  (git-ignored; copy .env.vars.example)
#   2. `.env`       — this file: non-secret settings and defaults
# `.env.vars` wins on conflicts, and real process env (CI, docker,
# `infisical run`) wins over both. So keep keys OUT of this file:
#
#   .env.vars   →  *API_KEY, JWT_SECRET, LIBSQL_AUTH_TOKEN, DB passwords
#   .env        →  PORT, NODE_ENV, DATABASE_URL, DATABASE_PATH, *_MODEL(s)
# ────────────────────────────────────────────────────────────────

# ── AI providers (OpenAI-compatible — automatic failover) ────────
# Add ONE or MORE provider keys. They form a failover chain:
# when one provider is rate-limited (429) or down, the next answers.
# Order can be customized with AI_PROVIDER_ORDER (comma-separated ids).
#
#   groq       https://api.groq.com/openai/v1         (free tier)
#   cohere     https://api.cohere.ai/compatibility/v1 (free trial key)
#   openrouter https://openrouter.ai/api/v1           (free models)
#   cerebras   https://api.cerebras.ai/v1             (free tier)
#   mistral    https://api.mistral.ai/v1
#   hf         https://router.huggingface.co/v1       (free tier)
#   ollama     local, no key — set OLLAMA_BASE_URL=http://localhost:11434/v1
#   xkiro      https://api.xkiro.com/v1               (multi-model gateway)
#
# The provider KEYS belong in `.env.vars`, not here. Listed only so you
# know which keys the app looks for.
#
# GROQ_API_KEY=your_groq_key_here        → .env.vars
# COHERE_API_KEY=                        → .env.vars
# OPENROUTER_API_KEY=                    → .env.vars
# CEREBRAS_API_KEY=                      → .env.vars
# MISTRAL_API_KEY=                       → .env.vars
# HF_API_KEY=                            → .env.vars
# XKIRO_API_KEY=                         → .env.vars
# OLLAMA_BASE_URL=http://localhost:11434/v1   (no key — fine to keep here)

# ── Multi-model gateways ─────────────────────────────────────────
# A gateway can serve MANY models under one key. Every model you list
# becomes selectable in Settings → AI model, and the FIRST one is the
# default for this provider. xkiro currently exposes 100+ models
# (GPT-5.x, Claude, Gemini, DeepSeek, Kimi, GLM, Qwen, Grok, Mistral…).
#
# XKIRO_MODELS=qwen/qwen3.5-flash:free,cohere/command-a-plus
# XKIRO_MODEL=qwen/qwen3.5-flash:free        (just change the default)

# Optional per-provider model overrides (defaults are sensible):
# GROQ_MODEL=llama-3.3-70b-versatile
# COHERE_MODEL=command-r7b-12-2024
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional explicit chain order, e.g. Groq first then Xkiro:
# AI_PROVIDER_ORDER=xkiro,groq

# ── Legacy single-provider config (still honored, chain position 1) ──
# AI_API_URL=https://api.groq.com/openai/v1
# AI_API_KEY=your_api_key_here
# AI_MODEL=llama-3.3-70b-versatile
# AI_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# ── Web access (chatbot can search the web) ─────────────────────
WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=8000
# WEB_SEARCH_MAX_CHARS=4500

# ── Database (pluggable — SQLite, Postgres, or Turso) ───────────
# Leave DATABASE_URL empty (default) to use the zero-config local
# SQLite file at DATABASE_PATH below.
#
# ── OPTION A: Turso / libSQL (SQLite over HTTP) ──
# Paste the "Database URL" from the Turso dashboard (turso.io → your
# database → Connection). The URL itself is not a secret and can stay here;
# the auth TOKEN belongs in `.env.vars` as LIBSQL_AUTH_TOKEN.
#
# DATABASE_URL=libsql://your-db-yourname.turso.io
# LIBSQL_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   → .env.vars
#
# The token may also ride along on the URL:
# DATABASE_URL=libsql://your-db.turso.io?authToken=YOUR_TOKEN
#
# ── OPTION B: any Postgres provider ──
# Neon, Supabase, Railway, RDS or self-hosted — same schema, same queries:
#
#   Neon:      postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
#   Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Railway:   postgresql://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
#   RDS/other: postgresql://user:pass@your-host:5432/yourdb
#
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# Local SQLite file location (used only when DATABASE_URL is empty):
DATABASE_PATH=data/lumina.db

# ── Server ───────────────────────────────────────────────────────
PORT=3017
NODE_ENV=development

# Secret used to sign session tokens — put this in `.env.vars`, NOT here.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=  → .env.vars

# How many previous messages to send to the AI as context
AI_CONTEXT_LIMIT=20