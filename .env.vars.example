# ─────────────────────────────────────────────────────────────────────────────
# .env.vars — LOCAL SECRETS (git-ignored, never commit this file)
# Copy to `.env.vars` and fill in. Loaded BEFORE `.env`, so these values win.
#   cp .env.vars.example .env.vars
#
# `.env` keeps only non-secret settings (ports, paths, model names, URLs).
# Anything secret lives here: database tokens, API keys, signing secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Turso / libSQL database token (DB-scoped, from the Turso dashboard).
# The DATABASE_URL itself is non-secret and lives in `.env`.
LIBSQL_AUTH_TOKEN=

# AI provider API keys.
AI_API_KEY=
XKIRO_API_KEY=

# Signs session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
